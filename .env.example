# Fyers API Credentials
# Copy this file to .env and fill in your actual credentials

FYERS_APP_ID=your_app_id_here
FYERS_APP_SECRET=your_app_secret_here
FYERS_REDIRECT_URL=https://127.0.0.1:8080
FYERS_ACCESS_TOKEN=your_access_token_here

# ---------------------------------------------------------------
# OPTIONAL: Automatic re-login (Fyers tokens expire every day)
# ---------------------------------------------------------------
# Fill these in and the scanner re-authenticates BY ITSELF when the
# daily token expires - no manual login.py needed anymore.
#
#   FYERS_USER_ID     : your Fyers id (e.g. YC00160 - no dashes)
#   FYERS_PIN         : your 4/6-digit Fyers login PIN
#   FYERS_TOTP_SECRET : base32 TOTP secret. In Fyers web:
#                       MyAccount -> Manage Account -> TOTP ->
#                       'Show secret' -> copy the letter string
#   FYERS_AUTO_LOGIN  : 1 = enabled (default), 0 = disable
#
# WARNING: anyone with these values can log into your Fyers account.
# Keep .env private (it is already gitignored).
# FYERS_USER_ID=
# FYERS_PIN=
# FYERS_TOTP_SECRET=
# FYERS_AUTO_LOGIN=1
